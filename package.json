{
	"name": "aether",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "rm -rf node_modules/.vite .svelte-kit && svelte-kit sync && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"mcp:supabase": "npx @supabase/mcp-server-supabase@latest --project-ref hsxjcowijclwdxcmhbhs",
		"mcp:playwright": "npx @playwright/mcp@latest",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:all": "npm run test && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/mcp": "0.0.48",
		"@supabase/mcp-server-supabase": "0.5.9",
		"@sveltejs/adapter-auto": "7.0.0",
		"@sveltejs/kit": "2.49.0",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.19",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.2.9",
		"@types/marked": "5.0.2",
		"@types/turndown": "^5.0.6",
		"@vitest/ui": "4.0.14",
		"autoprefixer": "10.4.22",
		"happy-dom": "20.0.11",
		"jsdom": "27.2.0",
		"playwright": "1.57.0",
		"postcss": "8.5.6",
		"svelte": "5.45.2",
		"svelte-check": "4.3.4",
		"tailwindcss": "4.1.17",
		"tsx": "4.20.6",
		"typescript": "5.9.3",
		"vite": "7.2.4",
		"vitest": "4.0.14"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.71.0",
		"@gradio/client": "^2.0.0",
		"@resvg/resvg-js": "2.6.2",
		"@supabase/ssr": "0.8.0",
		"@supabase/supabase-js": "2.86.0",
		"@tailwindcss/postcss": "4.1.17",
		"@types/node": "24.10.1",
		"@upstash/redis": "1.35.7",
		"cheerio": "1.1.2",
		"chokidar": "^5.0.0",
		"isomorphic-dompurify": "2.33.0",
		"jsonrepair": "3.13.1",
		"konva": "^10.0.12",
		"marked": "17.0.1",
		"pdf-parse": "2.4.5",
		"satori": "0.18.3",
		"sharp": "0.34.5",
		"svelte-icons-pack": "3.1.3",
		"svelte-konva": "^1.0.1",
		"turndown": "^7.2.2",
		"voyageai": "0.0.8",
		"zod": "4.1.13"
	}
}
